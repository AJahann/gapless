# Server
PORT=4000
HOST=0.0.0.0
# Comma-separated browser origins allowed for HTTP CORS and WS handshakes
CLIENT_ORIGIN=http://localhost:3000
# Replay window kept per feed (seconds). E2E sets this low to force snapshot path.
REPLAY_WINDOW_SEC=30
# Hard cap on replay ring entries per feed regardless of rate
REPLAY_MAX_ENTRIES=100000
HEARTBEAT_MS=1000
# Allow clients to enable per-connection fault injection (chaos panel)
CHAOS_ENABLED=true
# Stop a feed with no subscribers after this many seconds (new epoch on restart)
FEED_IDLE_TTL_SEC=300

# Web
NEXT_PUBLIC_FEED_URL=http://localhost:4000
