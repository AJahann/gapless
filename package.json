{
  "name": "gapless",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Real-time market dashboard demo: sequenced deltas, gap detection, replay and snapshot recovery under chaos.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gapless/server --filter @gapless/web dev",
    "dev:server": "pnpm --filter @gapless/server dev",
    "dev:web": "pnpm --filter @gapless/web dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --config ./oxlint.config.ts apps packages",
    "lint:fix": "oxlint --config ./oxlint.config.ts --fix apps packages",
    "format": "biome format --write",
    "format:check": "biome ci",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fullstacksjs/oxlint-config": "1.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "oxlint": "1.93.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
